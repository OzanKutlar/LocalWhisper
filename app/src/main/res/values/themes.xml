<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.LocalWhisper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lw_accent</item>
        <item name="colorOnPrimary">@color/lw_accent_on</item>
        <item name="colorPrimaryContainer">@color/lw_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/lw_accent_on_container</item>
        <item name="android:colorBackground">@color/lw_bg</item>
        <item name="android:windowBackground">@color/lw_bg</item>
        <item name="colorSurface">@color/lw_card_bg</item>
        <item name="colorOnSurface">@color/lw_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lw_text_secondary</item>
        <item name="colorOutlineVariant">@color/lw_card_stroke</item>
        <item name="colorError">@color/lw_error</item>
    </style>

    <style name="Theme.LocalWhisper" parent="Base.Theme.LocalWhisper" />

    <style name="Theme.LocalWhisper.Assistant" parent="Theme.LocalWhisper">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.58</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

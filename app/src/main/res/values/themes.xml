<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.LocalWhisper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lw_accent</item>
        <item name="colorOnPrimary">@color/lw_accent_on</item>
        <item name="colorPrimaryContainer">@color/lw_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/lw_accent_on_container</item>
        <item name="android:colorBackground">@color/lw_bg</item>
        <item name="android:windowBackground">@color/lw_bg</item>
        <item name="colorSurface">@color/lw_card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/lw_card_bg</item>
        <item name="colorOnSurface">@color/lw_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lw_text_secondary</item>
        <item name="colorOutline">@color/lw_text_secondary</item>
        <item name="colorOutlineVariant">@color/lw_divider</item>
        <item name="colorError">@color/lw_error</item>
    </style>

    <style name="Theme.LocalWhisper" parent="Base.Theme.LocalWhisper" />

    <style name="Theme.LocalWhisper.Assistant" parent="Theme.LocalWhisper">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- One UI style building blocks -->
    <style name="Widget.LocalWhisper.GroupCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/lw_card_bg</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.LocalWhisper.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/lw_section_header</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LocalWhisper.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.LocalWhisper.RowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lw_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.LocalWhisper.RowValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/lw_accent</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.LocalWhisper.RowSummary" parent="Widget.LocalWhisper.RowValue">
        <item name="android:textColor">@color/lw_text_secondary</item>
    </style>

    <style name="Widget.LocalWhisper.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">@color/lw_divider</item>
    </style>

    <style name="Widget.LocalWhisper.PlayerControl" parent="">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/lw_text_primary</item>
    </style>
</resources>

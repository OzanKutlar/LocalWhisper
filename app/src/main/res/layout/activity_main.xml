<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lw_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/lw_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionStatusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/main_status_untested"
            android:textColor="@color/lw_text_secondary"
            android:textSize="15sp" />

        <!-- Server section -->
        <TextView
            style="@style/Widget.LocalWhisper.SectionHeader"
            android:text="@string/section_server" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.LocalWhisper.GroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/serverAddressRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_server_address" />

                    <TextView
                        android:id="@+id/serverAddressValue"
                        style="@style/Widget.LocalWhisper.RowValue" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/languageRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_language" />

                    <TextView
                        android:id="@+id/languageValue"
                        style="@style/Widget.LocalWhisper.RowValue" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/testConnectionRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_test_connection" />

                    <TextView
                        android:id="@+id/testConnectionSubtitle"
                        style="@style/Widget.LocalWhisper.RowSummary"
                        android:text="@string/row_test_connection_hint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Assistant section -->
        <TextView
            style="@style/Widget.LocalWhisper.SectionHeader"
            android:text="@string/section_assistant" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.LocalWhisper.GroupCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/micPermissionRow"
                    style="@style/Widget.LocalWhisper.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.LocalWhisper.RowTitle"
                            android:text="@string/row_mic_permission" />

                        <TextView
                            android:id="@+id/micPermissionSubtitle"
                            style="@style/Widget.LocalWhisper.RowSummary"
                            android:text="@string/mic_permission_missing" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/micPermissionSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/defaultAssistantRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_default_assistant" />

                    <TextView
                        android:id="@+id/defaultAssistantSubtitle"
                        style="@style/Widget.LocalWhisper.RowValue"
                        android:text="@string/default_assistant_inactive" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/launchOverlayRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_launch_overlay" />

                    <TextView
                        style="@style/Widget.LocalWhisper.RowSummary"
                        android:text="@string/row_launch_overlay_hint" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/keyboardModeRow"
                    style="@style/Widget.LocalWhisper.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.LocalWhisper.RowTitle"
                            android:text="@string/row_keyboard_mode" />

                        <TextView
                            style="@style/Widget.LocalWhisper.RowSummary"
                            android:text="@string/row_keyboard_mode_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/keyboardModeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/agentModeRow"
                    style="@style/Widget.LocalWhisper.Row"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.LocalWhisper.RowTitle"
                            android:text="@string/row_agent_mode" />

                        <TextView
                            style="@style/Widget.LocalWhisper.RowSummary"
                            android:text="@string/row_agent_mode_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/agentModeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <View style="@style/Widget.LocalWhisper.Divider" />

                <LinearLayout
                    android:id="@+id/typeOnPhoneRow"
                    style="@style/Widget.LocalWhisper.Row">

                    <TextView
                        style="@style/Widget.LocalWhisper.RowTitle"
                        android:text="@string/row_type_on_phone" />

                    <TextView
                        android:id="@+id/typeOnPhoneSubtitle"
                        style="@style/Widget.LocalWhisper.RowValue"
                        android:text="@string/type_on_phone_inactive" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

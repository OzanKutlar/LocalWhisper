<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lw_scrim">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/lw_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <!-- Focus sink: stray focus (e.g. after views are rebuilt) lands here instead of a text field. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <!-- Header: state, target and actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/assistant_state_listening"
                        android:textColor="@color/lw_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/targetPcText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:background="?attr/selectableItemBackground"
                        android:ellipsize="end"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:singleLine="true"
                        android:textColor="@color/lw_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agentModeButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/assistant_agent_mode_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_sparkle"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/lw_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyboardModeButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/assistant_keyboard_mode_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_keyboard"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/lw_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSettingsButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/assistant_settings_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/lw_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-10dp"
                android:contentDescription="@string/assistant_close_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/lw_text_secondary" />
        </LinearLayout>

        <!-- Agent Session Bar: switch between new chat or continuing previous sessions -->
        <LinearLayout
            android:id="@+id/agentSessionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/sessionSelectorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="@string/assistant_session_new"
                android:textColor="@color/lw_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/viewChatHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:textColor="@color/lw_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newSessionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="@string/assistant_session_new_button"
                android:textColor="@color/lw_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Stage: waveform, spinner, transcript box, sent check or setup message -->
        <FrameLayout
            android:id="@+id/stageArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="112dp">

                <me.Integer.localwhisper.WaveformView
                    android:id="@+id/waveformView"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/transcribingSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/lw_accent"
                    app:indicatorSize="56dp"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <ImageView
                    android:id="@+id/sentCheckIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/assistant_state_sent"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/lw_success" />

                <EditText
                    android:id="@+id/transcriptInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_panel"
                    android:maxLines="6"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:hint="@string/assistant_transcript_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="14dp"
                    android:textColor="@color/lw_text_primary"
                    android:textColorHint="@color/lw_text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <!-- Agent Result Section: Multi-turn chat history thread & confirmation gate -->
                <ScrollView
                    android:id="@+id/agentResultScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="false"
                    android:scrollbars="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/agentResultContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Dynamic Multi-Turn Chat History Container -->
                        <LinearLayout
                            android:id="@+id/chatHistoryContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Confirmation Gate Card (Idea #10) -->
                        <LinearLayout
                            android:id="@+id/confirmationGateCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_error_banner"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/confirmationTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/assistant_confirm_title"
                                android:textColor="@color/lw_error"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/confirmationDescriptionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/lw_text_primary"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/confirmationPreviewImage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:adjustViewBounds="true"
                                android:background="@drawable/bg_info_panel"
                                android:contentDescription="@string/assistant_confirm_preview_desc"
                                android:maxHeight="240dp"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <EditText
                                android:id="@+id/rejectionReasonInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_info_panel"
                                android:hint="@string/assistant_confirm_reject_reason_hint"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLines="3"
                                android:paddingStart="12dp"
                                android:paddingTop="9dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="9dp"
                                android:textColor="@color/lw_text_primary"
                                android:textColorHint="@color/lw_text_secondary"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/rejectConfirmButton"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="@string/assistant_confirm_reject"
                                    android:textColor="@color/lw_error" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/approveConfirmButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/assistant_confirm_approve" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:id="@+id/setupRequiredSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/setupRequiredMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/assistant_mic_required"
                        android:textColor="@color/lw_text_secondary"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openMainButton"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="@string/assistant_open_settings"
                        app:cornerRadius="26dp" />
                </LinearLayout>
        </FrameLayout>

        <!-- Mid-run Interject / Steer Bar (visible while Agent is thinking or paused) -->
        <LinearLayout
            android:id="@+id/interjectBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/interjectInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_info_panel"
                android:hint="@string/assistant_interject_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textColor="@color/lw_text_primary"
                android:textColorHint="@color/lw_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/interjectSendButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/assistant_interject_send_desc"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/lw_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/lw_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Unsent recording: kept after a failed transcription so it can be re-sent -->
        <LinearLayout
            android:id="@+id/retryRecordingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_info_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/retryRecordingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/lw_text_primary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discardRecordingButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_discard_recording"
                android:textColor="@color/lw_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryRecordingButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_retry_transcription"
                android:textColor="@color/lw_accent"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/lw_accent" />
        </LinearLayout>

        <!-- AHK key chips (review only) -->
        <HorizontalScrollView
            android:id="@+id/chipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ahkChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- Recording progress (recording only) -->
        <LinearLayout
            android:id="@+id/progressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.slider.Slider
                android:id="@+id/recordingSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:valueFrom="0"
                android:valueTo="120"
                app:haloRadius="0dp"
                app:labelBehavior="gone"
                app:thumbColor="@color/lw_text_primary"
                app:thumbElevation="0dp"
                app:thumbRadius="8dp"
                app:tickVisible="false"
                app:trackColorActive="@color/lw_text_primary"
                app:trackColorInactive="@color/lw_slider_inactive"
                app:trackHeight="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/lw_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/maxTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:00"
                    android:textColor="@color/lw_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Player controls -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/controlLeft"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/lw_text_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/controlCenter"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_stop"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="40dp"
                    app:iconTint="@color/lw_text_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/controlRight"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_restart"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/lw_text_primary" />
            </FrameLayout>
        </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
